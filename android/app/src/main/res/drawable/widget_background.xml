<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget card. Radius matches the app's own cards so the two read as the
  same product. Android 12+ clips widgets to the launcher's corner radius
  anyway; this keeps the shape correct on older releases.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="20dp" />
</shape>
