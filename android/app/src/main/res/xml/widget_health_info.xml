<?xml version="1.0" encoding="utf-8"?>
<!--
  The health widget. Fixed at 2x2 and updated rarely: measured capacity moves
  over months, so there is nothing to gain from refreshing it often.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_health"
    android:previewLayout="@layout/widget_health"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_health_description"
    android:updatePeriodMillis="1800000" />
