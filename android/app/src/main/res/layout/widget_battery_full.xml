<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 — the full panel, and the one that justifies installing the app.

  The ring carries the level and state; the sparkline underneath shows the
  shape of the last few hours. That second part is the whole point: a stock
  battery widget can tell you the level, but only one backed by a sampler can
  show you whether the battery is falling off a cliff or coasting.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/widget_gauge"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/widget_gauge_a11y" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_dash"
                android:textColor="@color/widget_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_dash"
                android:textColor="@color/widget_accent"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/widget_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_dash"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_health"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_health_measuring"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_sparkline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_sparkline_a11y" />
</LinearLayout>
