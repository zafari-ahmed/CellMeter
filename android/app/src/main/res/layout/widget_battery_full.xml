<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2. The full panel: gauge, four live figures, and health along the bottom.

  The gauge is an ImageView rather than a drawn view because RemoteViews cannot
  host a custom View; GaugeRenderer paints it to a bitmap on each update.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp"
    android:baselineAligned="false">

    <ImageView
        android:id="@+id/widget_gauge"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_marginEnd="18dp"
        android:contentDescription="@string/widget_gauge_a11y" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_current"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/widget_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_dash"
                    android:textColor="@color/widget_primary"
                    android:textSize="16sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_power"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/widget_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_dash"
                    android:textColor="@color/widget_text"
                    android:textSize="16sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_temperature"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/widget_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_dash"
                    android:textColor="@color/widget_text"
                    android:textSize="16sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_forecast_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_remaining"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_forecast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_dash"
                    android:textColor="@color/widget_accent"
                    android:textSize="16sp"
                    android:layout_marginTop="2dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/widget_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/widget_health"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_health_measuring"
                android:textColor="@color/widget_text_muted"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!--
              A Chronometer counting up from the last push, rather than a static
              "updated now" written at render time. If Android suspends the
              sampler, this keeps ticking and the staleness becomes visible,
              instead of an old reading sitting there looking current.
            -->
            <Chronometer
                android:id="@+id/widget_stale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text_faint"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
