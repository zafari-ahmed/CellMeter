<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2. Health ring and measured capacity against design.

  A "check in weekly" widget rather than a live one: this number moves over
  months, not seconds.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:baselineAligned="false">

    <ImageView
        android:id="@+id/widget_gauge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@string/widget_health_a11y" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_health"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/widget_capacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_dash"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_design"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_health_measuring"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
