<?xml version="1.0" encoding="utf-8"?>
<!--
  2x2 — grown vertically rather than across.

  This case was missing: the size picker only looked at width, so a widget
  made taller kept the 2x1 layout and sat in a half-empty card. A tall narrow
  cell has room for the sparkline, which is the thing worth showing, so it
  gets one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <ImageView
            android:id="@+id/widget_gauge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="11dp"
            android:contentDescription="@string/widget_gauge_a11y" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/widget_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_level"
                    android:textColor="@color/widget_text"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_percent"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="13sp"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_dash"
                android:textColor="@color/widget_primary"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_dash"
            android:textColor="@color/widget_text_muted"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_forecast"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/widget_placeholder_dash"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_sparkline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_sparkline_a11y" />
</LinearLayout>
