<?xml version="1.0" encoding="utf-8"?>
<!--
  2x1. The glanceable one: level and current, nothing else.

  Everything a RemoteViews layout can use is limited to a small set of view
  types, so these layouts are plain nested LinearLayouts by necessity rather
  than by preference.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_brand"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp"
        android:letterSpacing="0.05"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_level"
            android:textColor="@color/widget_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_percent"
            android:textColor="@color/widget_text_muted"
            android:textSize="13sp"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_placeholder_dash"
        android:textColor="@color/widget_primary"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
